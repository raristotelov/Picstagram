# Server environment variables
# Copy to .env and fill in real values

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/picstagram
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://127.0.0.1:27017/picstagram

# Port the server listens on
PORT=5000

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=your_jwt_secret_here

# Environment: development | production
NODE_ENV=development
