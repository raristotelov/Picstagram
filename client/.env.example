# Client environment variables (Create React App)
# Copy to .env and fill in real values.
# Only variables prefixed with REACT_APP_ are exposed to the browser.

# Base URL of the backend API
REACT_APP_API_URL=http://localhost:5000

# Cloudinary (unsigned image uploads)
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
